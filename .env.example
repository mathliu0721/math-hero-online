# Copy to .env and fill locally. Never paste keys into a chat or client project.
AI_API_KEY=
AI_BASE_URL=https://api.siliconflow.cn/v1
# Copy the exact currently available text model ID from the provider console.
AI_MODEL=
# CNY per 1,000,000 input/output tokens. Blank disables paid AI.
# Only enter 0 if your actual selected model is confirmed free.
AI_INPUT_PER_MILLION=
AI_OUTPUT_PER_MILLION=
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
# CNY per minute of audio. Blank disables transcription.
ASR_PER_MINUTE=
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex
# CNY per 1,000 characters. Blank disables cloud speech synthesis.
TTS_PER_THOUSAND_CHARS=
MONTHLY_BUDGET_CNY=100
HOST=127.0.0.1
PORT=8787
# Only needed if a browser frontend is hosted on a different origin.
ALLOWED_ORIGINS=
